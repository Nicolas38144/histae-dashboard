{
	admin off
	auto_https off
	persist_config off
	log default {
		output stderr
		level ERROR
		# Keep request failures only in sanitized access logs.
		exclude http.log.access http.log.error
	}
	servers {
		trusted_proxies static 172.30.0.4/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

import caddy-common.caddy
:80 {
	import histae_access
	root * /srv
	encode gzip {
		minimum_length 256
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	map "{remote_host}:{header.X-Forwarded-Proto}" {histae_forwarded_proto} {
		"172.30.0.4:https" https
		default {scheme}
	}
	@secure expression `{histae_forwarded_proto} == "https"`
	header @secure Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		>Cache-Control no-store
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	handle /healthz {
		respond 204
	}
	handle /api {
		respond 404
	}
	# Keep /api, query, cookies and Origin intact; API errors never use the SPA fallback.
	handle /api/* {
		reverse_proxy {$HISTAE_API_UPSTREAM:http://api:8080} {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For "{client_ip}, {remote_host}"
			header_up X-Forwarded-Proto {histae_forwarded_proto}
			header_up X-Forwarded-Host {hostport}
			header_down -Cache-Control
			header_down -Expires
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}
	@private path_regexp (?i)(?:^|/)\.|^/(?:src|tests|node_modules)(?:/|$)|\.(?:map|ts|tsx|jsx)$
	handle @private {
		respond 404
	}
	# Missing files return 404; only application routes fall back to index.html.
	@file path_regexp /[^/]+\.[^/]+$
	handle /assets/* {
		file_server
	}
	handle @file {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
